generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model banners {
  id         Int     @id @default(autoincrement())
  title      String  @db.VarChar(100)
  subtitle   String? @db.VarChar(200)
  image_url  String
  link_url   String?
  sort_order Int     @default(0)
  is_active  Boolean @default(true)
}

model companyinfo {
  id                 Int     @id @default(autoincrement())
  company_name       String? @db.VarChar(100)
  ceo_name           String? @db.VarChar(50)
  business_reg_num   String? @db.VarChar(50)
  mail_order_reg_num String? @db.VarChar(50)
  address            String? @db.VarChar(255)
  @@map("companyinfo") 
}

model site_settings {
  id         Int      @id @default(1)
  logo_name  String   @db.VarChar(255)
  logo_path  String   @db.VarChar(255)
  updated_at DateTime @default(now()) @db.Timestamp(0)
  @@map("site_settings") // 
}

model Review {
  category    String 
  id          Int      @id @default(autoincrement())
  title       String   
  user_name   String
  phone_last  String
  password    String
  content     String   @db.Text
  image_url   String?
  ip_address  String
  views       Int      @default(0)
  status      String   @default("pending")
  likes       Int      @default(0)
  admin_reply String?  @db.Text
  created_at  DateTime @default(now())
   
  @@map("reviews")
}
model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  name     String
  role     String  @default("USER")
  level    Int     @default(1)
  permissionLevel PermissionLevel @relation(fields: [level], references: [level])
  @@map("user")
}
model ConsultationRequest {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(50)
  phone     String   @db.VarChar(20)
  ip        String   @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("consultation_requests")
}
model PermissionLevel {
  level     Int    @id
  levelName String @map("level_name")
  users     User[] // 이 레벨을 가진 사용자 목록

  @@map("permissionlevel") //
}


// 메뉴 관리 테이블
model menu_items {
  id            Int     @id @default(autoincrement())
  name          String
  link          String
  display_order Int     @default(0)
  is_external   Boolean @default(false)
}

// 통신사 테이블
model carriers {
  id             Int              @id @default(autoincrement())
  name           String
  img            String
  product_prices product_prices[]
}

// 인터넷 상품(속도) 테이블
model internet_plans {
  id             Int              @id @default(autoincrement())
  speed_name     String
  product_prices product_prices[]
}

// TV 상품(채널) 테이블
model tv_plans {
  id             Int              @id @default(autoincrement())
  name           String
  product_prices product_prices[]
}

// 가격 관리 (연결 테이블)
model product_prices {
  id                    Int            @id @default(autoincrement())
  carrier_id            Int
  internet_plan_id      Int
  tv_plan_id            Int
  price                 Int
  mobile_discount_price Int?
  carrier               carriers       @relation(fields: [carrier_id], references: [id])
  internet_plan         internet_plans @relation(fields: [internet_plan_id], references: [id])
  tv_plan               tv_plans       @relation(fields: [tv_plan_id], references: [id])
}