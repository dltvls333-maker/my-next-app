generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model banners {
  id         Int     @id @default(autoincrement())
  title      String  @db.VarChar(100)
  subtitle   String? @db.VarChar(200)
  image_url  String
  link_url   String?
  sort_order Int     @default(0)
  is_active  Boolean @default(true)
}

model companyinfo {
  id                 Int     @id @default(autoincrement())
  company_name       String? @db.VarChar(100)
  ceo_name           String? @db.VarChar(50)
  business_reg_num   String? @db.VarChar(50)
  mail_order_reg_num String? @db.VarChar(50)
  address            String? @db.VarChar(255)

  @@map("companyinfo")
}

model site_settings {
  id         Int      @id @default(1)
  logo_name  String   @db.VarChar(255)
  logo_path  String   @db.VarChar(255)
  updated_at DateTime @default(now()) @db.Timestamp(0)

  @@map("site_settings")
}

model Review {
  category    String
  id          Int      @id @default(autoincrement())
  title       String
  user_name   String
  phone_last  String
  password    String
  content     String   @db.Text
  image_url   String?
  ip_address  String
  views       Int      @default(0)
  status      String   @default("pending")
  likes       Int      @default(0)
  admin_reply String?  @db.Text
  created_at  DateTime @default(now())

  @@map("reviews")
}

model User {
  id              Int             @id @default(autoincrement())
  email           String          @unique
  password        String
  name            String
  role            String          @default("USER")
  level           Int             @default(1)
  permissionLevel PermissionLevel @relation(fields: [level], references: [level], onDelete: NoAction)

  @@index([level], map: "user_level_fkey")
  @@map("user")
}

model ConsultationRequest {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(50)
  phone     String   @db.VarChar(20)
  ip        String   @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("consultation_requests")
}

model PermissionLevel {
  level     Int    @id
  levelName String @map("level_name")
  users     User[]

  @@map("permissionlevel")
}

model menu_items {
  id            Int     @id @default(autoincrement())
  name          String
  link          String
  display_order Int     @default(0)
  is_external   Boolean @default(false)
}

model carriers {
  id             Int              @id @default(autoincrement())
  name           String
  img            String
  product_prices product_prices[]
}

model internet_plans {
  id             Int              @id @default(autoincrement())
  speed_name     String
  product_prices product_prices[]
}

model tv_plans {
  id             Int              @id @default(autoincrement())
  name           String
  product_prices product_prices[]
}

model product_prices {
  id                    Int            @id @default(autoincrement())
  carrier_id            Int
  internet_plan_id      Int
  tv_plan_id            Int
  price                 Int
  mobile_discount_price Int?
  carrier               carriers       @relation(fields: [carrier_id], references: [id], onDelete: NoAction)
  internet_plan         internet_plans @relation(fields: [internet_plan_id], references: [id], onDelete: NoAction)
  tv_plan               tv_plans       @relation(fields: [tv_plan_id], references: [id], onDelete: NoAction)

  @@index([carrier_id], map: "product_prices_carrier_id_fkey")
  @@index([internet_plan_id], map: "product_prices_internet_plan_id_fkey")
  @@index([tv_plan_id], map: "product_prices_tv_plan_id_fkey")
}
